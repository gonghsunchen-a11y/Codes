#include <Arduino.h>
#define ESP_SERIAL Serial6

// 球的資料（ 之後換成實際的感測器資料）
uint8_t ball_dist  = 100;  // 0-255
uint8_t ball_angle = 18;   // 1-36
int8_t robot_x    = -50;   // -128到127
int8_t robot_y    = 50;   // -128到127

void setup() {
  Serial.begin(115200);
  ESP_SERIAL.begin(115200);
  Serial.println("Teensy Ready");
}

void loop() {
  if (ESP_SERIAL.available() > 0) {
    uint8_t data = ESP_SERIAL.read();

    if (data == 0xAA) {
      // 收到 0xAA，回送封包
      ESP_SERIAL.write(0xBB);         // 起始
      ESP_SERIAL.write(ball_dist);
      ESP_SERIAL.write(ball_angle);
      ESP_SERIAL.write(robot_x);
      ESP_SERIAL.write(robot_y);
      ESP_SERIAL.write(0xEE);         // 結尾

      Serial.println("Sent packet to ESP32");
    }
  }
}
