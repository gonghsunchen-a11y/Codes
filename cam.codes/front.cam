#cam main
from maix import camera, display, image, uart, app, time


# === 初始化 ===
cam = camera.Camera(320, 240, image.Format.FMT_RGB888)


cam.set_awb(1)           # 關閉自動白平衡
disp = display.Display()
ser = uart.UART("/dev/ttyS1", 921600)


# === 藍色球門 LAB 閾值 ===
# RGB (0, 90, 190) 對應的 LAB 大約是 L:35~65, A:-10~10, B:-60~-20
GOAL_LAB = [52, 102, -30, 14, 54, 102]
#yellow = [36, 82, -25, 16, 41, 86]
#blue =
goal_roi = (0, 0, 320, 240)


def pack_uint16(val):
    v = int(val) & 0xFFFF
    return v & 0xFF, (v >> 8) & 0xFF


while not app.need_exit():
    img = cam.read()
    if img is None:
        continue


    # === 找球門 ===
    goal_blobs = img.find_blobs(
        [GOAL_LAB], roi=goal_roi,
        x_stride=5, y_stride=5,
        area_threshold=10, merge=True
    )


    # === 選最大 blob ===
    best_goal = None
    if goal_blobs:
        for b in goal_blobs:
            if not best_goal or b.pixels() > best_goal.pixels():
                best_goal = b


    # === 座標，沒找到填 65535 ===
    gx, gy, gw, gh = (best_goal.cx(), best_goal.cy(),
                      best_goal.w(), best_goal.h()) if best_goal else (65535, 65535, 0, 0)


    # === Debug 畫框 ===
    if best_goal:
        img.draw_rect(best_goal.x(), best_goal.y(),
                      best_goal.w(), best_goal.h(),
                      color=image.Color.from_rgb(0, 255, 255), thickness=2)
        img.draw_cross(gx, gy, color=image.Color.from_rgb(0, 255, 0), thickness=2)


    # === 印出 debug 資訊 ===
    print(f"goal=({gx},{gy}) w={gw} h={gh}")


    disp.show(img)


    # === UART 封包 (只送球門) ===
    gx0,gx1 = pack_uint16(gx)
    gy0,gy1 = pack_uint16(gy)
    gw0,gw1 = pack_uint16(gw)
    gh0,gh1 = pack_uint16(gh)


    packet = bytes([
        0xCC,
        gx0,gx1, gy0,gy1, gw0,gw1, gh0,gh1,
        0xEE
    ])
    ser.write(packet)
