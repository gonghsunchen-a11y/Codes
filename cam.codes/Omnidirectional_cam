W, H = 320, 240
CENTER_X, CENTER_Y = 160, 120
R_MIN, R_MAX = 45, 115

# 距離公式參數
A, B, C = 0.00183098896, 1800.121314,-19.93325639

hists = {
    "yellow": [],
    "blue": []
}
HIST_N = 5

YG = 100
ATTACK_Side = 1


def pack_int16(v):
    v = int(v)
    if v < 0:
        v += 65536
    return (v & 0xFF, (v >> 8) & 0xFF)


def point_radius(cx, cy):
    return math.hypot(cx - CENTER_X, cy - CENTER_Y)


def blob_radius(b):
    return point_radius(b.cx(), b.cy())


def angle_diff(a, b):
    return abs((a - b + math.pi) % (2 * math.pi) - math.pi)


def merge_goal_parts(blobs, color_code):
    parts = []

    for b in blobs:
        if b.code() != color_code:
            continue

        r = blob_radius(b)
        if not (R_MIN <= r <= R_MAX):
            continue

        if b.pixels() < 8:
            continue

        parts.append({
            "blob": b,
            "r": r,
            "ang": math.atan2(b.cy() - CENTER_Y, b.cx() - CENTER_X),
        })

    if not parts:
        return None

    main = max(parts, key=lambda p: p["blob"].pixels())
    main_r = main["r"]
    main_ang = main["ang"]

    group = []
    for p in parts:
        r_diff = abs(p["r"] - main_r)
        a_diff = angle_diff(p["ang"], main_ang)

        # 同一個球門：半徑要接近，角度允許被柱子切開一段
        if r_diff < 18 and a_diff < math.radians(45):
            group.append(p["blob"])

    if not group:
        group = [main["blob"]]

    x1 = min(b.x() for b in group)
    y1 = min(b.y() for b in group)
    x2 = max(b.x() + b.w() for b in group)
    y2 = max(b.y() + b.h() for b in group)

    # 用加權平均，比單純外框中心穩
    total_pixels = sum(b.pixels() for b in group)
    cx = sum(b.cx() * b.pixels() for b in group) // total_pixels
    cy = sum(b.cy() * b.pixels() for b in group) // total_pixels

    return {
        "x": x1,
        "y": y1,
        "w": x2 - x1,
        "h": y2 - y1,
        "cx": int(cx),
        "cy": int(cy),
        "pixels": total_pixels,
        "count": len(group)
    }
def calc_goal_position(goal, color_name):
    r = point_radius(goal["cx"], goal["cy"])

    hists[color_name].append(r)
    if len(hists[color_name]) > HIST_N:
        hists[color_name].pop(0)

    r_avg = sum(hists[color_name]) / len(hists[color_name])

    dist = max((A * (r_avg ** 2)) + (B / math.sqrt(goal["pixels"])) + C, 10.0)

    ang_rad = math.atan2(goal["cy"] - CENTER_Y, goal["cx"] - CENTER_X)
    ang_deg = math.degrees(ang_rad) % 360

    x_rel = dist * math.cos(ang_rad)
    y_rel = dist * math.sin(ang_rad)

    return x_rel, y_rel, dist, ang_deg
def find_ball_in_circle(img):
    ball_blobs = img.find_blobs(
        [BALL_LAB],
        roi=(CENTER_X - BALL_R, CENTER_Y - BALL_R, BALL_R * 2, BALL_R * 2),
        merge=True,
        area_threshold=BALL_MIN_PIXELS,
        pixels_threshold=BALL_MIN_PIXELS
    )

    best_ball = None

    if ball_blobs:
        for b in ball_blobs:
            r = point_radius(b.cx(), b.cy())

            if  r < R_MIN or r > BALL_R:
                continue

            if best_ball is None or b.pixels() > best_ball.pixels():
                best_ball = b

    if not best_ball:
        return None

    dx = best_ball.cx() - CENTER_X
    dy = best_ball.cy() - CENTER_Y

    ang_rad = math.atan2(dy, dx)
    ang_deg = int(math.degrees(ang_rad) % 360)
    dist = int(min(point_radius(best_ball.cx(), best_ball.cy()), 255))

    return {
        "blob": best_ball,
        "angle": ang_deg,
        "dist": dist
    }

