YELLOW_LAB = [33, 79, -28, 15, 35, 82]
BLUE_LAB = [30, 70, -25, 35, -75, -20]
BALL_LAB = [19, 70, 10, 53, 18, 76]



W, H = 320, 240
CENTER_X, CENTER_Y = 162, 123
R_MIN, R_MAX = 37, 105

BALL_R = 90
BALL_W_MIN = 4
BALL_W_MAX = 20
BALL_H_MIN = 4
BALL_H_MAX = 20
BALL_PIXELS_MIN = 8
BALL_PIXELS_MAX = 400

A, B, C = 0.00183098896, 1800.121314, -19.93325639

hists = {
    "yellow": [],
    "blue": []
}
HIST_N = 5

YG = 100
ATTACK_Side = 1

frame_count = 0
robot_x, robot_y = 0.0, 0.0
status = 0
best_y = None
best_b = None

last_ball_print = time.ticks_ms()
last_pos_print = time.ticks_ms()

def pack_int8(v):
    v = int(round(v))

    if v < -128:
        v = -128
    if v > 127:
        v = 127

    if v < 0:
        v += 256

    return v & 0xFF

def pack_int16(v):
    v = int(v)
    if v < 0:
        v += 65536
    return (v & 0xFF, (v >> 8) & 0xFF)


def point_radius(cx, cy):
    return math.hypot(cx - CENTER_X, cy - CENTER_Y)


def blob_radius(b):
    return point_radius(b.cx(), b.cy())


def angle_diff(a, b):
    return abs((a - b + math.pi) % (2 * math.pi) - math.pi)


def merge_goal_parts(blobs, color_code):
    parts = []

    for b in blobs:
        if b.code() != color_code:
            continue

        r = blob_radius(b)
        if not (R_MIN <= r <= R_MAX):
            continue

        if b.pixels() < 8:
            continue

        parts.append({
            "blob": b,
            "r": r,
            "ang": math.atan2(b.cy() - CENTER_Y, b.cx() - CENTER_X),
        })

    if not parts:
        return None

    main = max(parts, key=lambda p: p["blob"].pixels())
    main_r = main["r"]
    main_ang = main["ang"]

    group = []
    for p in parts:
        r_diff = abs(p["r"] - main_r)
        a_diff = angle_diff(p["ang"], main_ang)

        if r_diff < 18 and a_diff < math.radians(45):
            group.append(p["blob"])

    if not group:
        group = [main["blob"]]

    x1 = min(b.x() for b in group)
    y1 = min(b.y() for b in group)
    x2 = max(b.x() + b.w() for b in group)
    y2 = max(b.y() + b.h() for b in group)

    total_pixels = sum(b.pixels() for b in group)

    cx = (x1 + x2) // 2
    cy = sum(b.cy() * b.pixels() for b in group) // total_pixels

    return {
        "x": x1,
        "y": y1,
        "w": x2 - x1,
        "h": y2 - y1,
        "cx": int(cx),
        "cy": int(cy),
        "pixels": total_pixels,
        "count": len(group)
    }

