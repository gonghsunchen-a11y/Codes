from maix import camera, display, image, app, time, uart
import math

cam = camera.Camera(320, 240, image.Format.FMT_RGB888)
cam.set_awb(1)
disp = display.Display()

ser = uart.UART("/dev/ttyS0", 921600)

YELLOW_LAB = [63, 107, -33, 8, 63, 107]
BLUE_LAB = [18, 60, -17, 26, -65, -23]

W, H = 320, 240
CENTER_X, CENTER_Y = 160, 120
R_MIN, R_MAX = 30, 120

# 係數
A, B, C = 0.00113172720270608, 850.7345431, -20.336502089003

# 獨立平滑歷史
hists = { "yellow": [], "blue": [] }
HIST_N = 5

#半場距離
YG = 90
ATTACK_Side = 1 #1進攻黃門 -1藍門

def blob_radius(b):
    return math.hypot(b.cx() - CENTER_X, b.cy() - CENTER_Y)
def pack_int16(v):
    v = int(v)
    if v < 0:
        v += 65536
    return (v & 0xFF, (v >> 8) & 0xFF)

while not app.need_exit():
    img = cam.read()
    if img is None: continue
    img = img.flip(image.FlipDir.X)
    img = img.flip(image.FlipDir.Y)

    blobs = img.find_blobs([YELLOW_LAB, BLUE_LAB], merge=True)
   
    best_y = max([b for b in blobs if b.code() == 1 and R_MIN <= blob_radius(b) <= R_MAX], key=lambda b: b.pixels(), default=None)
    best_b = max([b for b in blobs if b.code() == 2 and R_MIN <= blob_radius(b) <= R_MAX], key=lambda b: b.pixels(), default=None)

    # 繪製參考圈
    img.draw_circle(CENTER_X, CENTER_Y, R_MIN, image.Color.from_rgb(0, 255, 0), 1)
    img.draw_circle(CENTER_X, CENTER_Y, R_MAX, image.Color.from_rgb(255, 0, 0), 1)
    img.draw_cross(CENTER_X, CENTER_Y, image.Color.from_rgb(255, 255, 255), 8, 1)

    pos_y = None # 格式: (x_rel, y_rel)
    pos_b = None
    
    # 處理黃球門
    if best_y:
        r_y = blob_radius(best_y)
        hists["yellow"].append(r_y)
        if len(hists["yellow"]) > HIST_N: hists["yellow"].pop(0)
        
        r_avg_y = sum(hists["yellow"]) / len(hists["yellow"])
        dist_y = max((A * (r_avg_y ** 2)) + (B / math.sqrt(best_y.pixels())) + C, 10.0)
        
        ang_rad_y = math.atan2(best_y.cy() - CENTER_Y, best_y.cx() - CENTER_X)
        ang_deg_y = (math.degrees(ang_rad_y)) % 360

        x_rel = dist_y * math.cos(ang_rad_y)  # 右為正
        y_rel = dist_y * math.sin(ang_rad_y)  # 前為正
        pos_y = (x_rel,y_rel)


        img.draw_rect(best_y.x(), best_y.y(), best_y.w(), best_y.h(), image.Color.from_rgb(0, 0, 0), 4)
        img.draw_rect(best_y.x(), best_y.y(), best_y.w(), best_y.h(), image.Color.from_rgb(255, 255, 0), 2)
        # 繪製連線 (從中心到球門中心)
        img.draw_line(CENTER_X, CENTER_Y, best_y.cx(), best_y.cy(), image.Color.from_rgb(255, 255, 255), 1)
        print(f"[YELLOW] Dist: {dist_y:.1f} cm, Ang: {ang_deg_y:.1f} deg")
    else: hists["yellow"].clear()

    # 處理藍球門
    if best_b:
        r_b = blob_radius(best_b)
        hists["blue"].append(r_b)
        if len(hists["blue"]) > HIST_N: hists["blue"].pop(0)
        
        r_avg_b = sum(hists["blue"]) / len(hists["blue"])
        dist_b = max((A * (r_avg_b ** 2)) + (B / math.sqrt(best_b.pixels())) + C, 10.0)
        
        ang_rad_b = math.atan2(best_b.cy() - CENTER_Y, best_b.cx() - CENTER_X)
        ang_deg_b = (math.degrees(ang_rad_b)) % 360
        
        x_rel = dist_b * math.cos(ang_rad_b)  # 右為正
        y_rel = dist_b * math.sin(ang_rad_b)  # 前為正
        pos_b = (x_rel, y_rel)
        
        img.draw_rect(best_b.x(), best_b.y(), best_b.w(), best_b.h(), image.Color.from_rgb(0, 0, 0), 4)
        img.draw_rect(best_b.x(), best_b.y(), best_b.w(), best_b.h(), image.Color.from_rgb(0, 165, 255), 2)
        
        # 繪製連線
        img.draw_line(CENTER_X, CENTER_Y, best_b.cx(), best_b.cy(), image.Color.from_rgb(255, 255, 255), 1)
        #print(f"[BLUE]   Dist: {dist_b:.1f} cm, Ang: {ang_deg_b:.1f} deg")
    else: hists["blue"].clear()

    

    robot_x, robot_y = 0.0, 0.0
    status = 0

    if pos_y and pos_b:
        x_y, y_y = pos_y
        x_b, y_b = pos_b
        robot_x = -(x_y + x_b) * 0.5 
        robot_y = -(y_y + y_b) * 0.5 
        status = 2
        print(f"World Pos: X={robot_x:.1f}, Y={robot_y:.1f}")
    elif pos_y and not pos_b:
    # 已知黃門位置 (x_y, y_y)
    # 推算藍門位置：因為球門對稱，藍門應在黃門對稱點
    # 將黃門向量反轉即可得到虛擬藍門
        x_y,y_y = pos_y
        x_b_virt = x_y
        y_b_virt = -y_y + (2 * YG * ATTACK_Side ) 
        status = 1

        robot_x = -(x_y + x_b_virt) * 0.5
        robot_y = (y_b_virt - y_y ) * 0.5
        
        print(f"World Pos: X={robot_x:.1f}, Y={robot_y:.1f}")
    elif not pos_y and pos_b:
        # 如果只看到藍門，同理推算黃門虛擬座標
        x_b,y_b = pos_b
        x_y_virt = x_b
        y_y_virt = -y_b - (2 * YG * ATTACK_Side )
        status = 1

        robot_x = -(x_y_virt + x_b) * 0.5
        robot_y = (y_y_virt - y_b) * 0.5

        print(f"World Pos: X={robot_x:.1f}, Y={robot_y:.1f}")
    #img = cam.read()            # Get one frame from camera, img is maix.image.Image type object                               # | 从摄像头获取一帧图像，img 是 maix.image.Image 类型的对象
    #disp.show(img)              # Show image to screen                               # | 将图像显示到屏幕
    #fps = time.fps()            # Calculate FPS between last time fps() call and this time call.                             # | 计算两次 fps 函数调用之间的帧率
    #print(f"time: {1000/fps:.02f}ms, fps: {fps:.02f}")

    #packet
    rx0, rx1 = pack_int16(robot_x)
    ry0, ry1 = pack_int16(robot_y)
    packet = bytes([
        0xCC,
        rx0, rx1,
        ry0, ry1,
        status,
        0xEE
    ])
    ser.write(packet)

    disp.show(img)